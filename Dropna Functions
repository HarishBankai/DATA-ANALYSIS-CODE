import pandas as pd  
import numpy as np

#Data Creation: A sample DataFrame containing a few NaN values is created.
data = {
    'X': [1, 2, np.nan, 4 , 5] ,
    'Y': [np.nan, np.nan, 10, 6 , 9] , 
    'Z': [17, np.nan, 20, 26 , np.nan] ,
    'H': [100, 25, 75, 56, 67]
}

df = pd.DataFrame(data)
print(df)

# Check for missing values
df.isnull().sum()
print("Number of missing values in each column:\n", df.isnull().sum())

# Dropping Rows with NaNs: Any row that contains a NaN value is dropped using df.dropna()
df_dropna_rows = df.dropna()
print("\nDataFrame after dropping rows with any missing values:\n", df_dropna_rows)

# Dropping Columns with NaNs: Any column that contains a NaN is dropped using df.dropna(axis=1)
df_dropna_columns = df.dropna(axis=1)
print("\nDataFrame after dropping columns with any missing values:\n", df_dropna_columns)

# Removing Rows with NaNs from Particular Columns: We only drop rows using df.dropna(subset=['Z']) if the designated columns (‘Z') have NaN values.
df_dropna_specific = df.dropna(subset=['Z'])
print("\nDataFrame after dropping columns with any missing values in specific columns:\n", df_dropna_specific)